# LLM 模型配置
LLM_PROVIDER=openai
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_API_KEY=xxx
LLM_MODEL=glm-5.2

# 采样参数（留空则使用模型默认值）
LLM_TEMPERATURE=
LLM_MAX_TOKENS=
LLM_TOP_P=

# 连接参数
LLM_TIMEOUT=300
LLM_MAX_RETRIES=2

# Neo4j 知识图谱
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=xxx

# MySQLMCP
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=xxx
MYSQL_DATABASE=
# SSE服务配置
MCP_TRANSPORT=sse
MCP_SSE_HOST=127.0.0.1
PORT=8000
# 后端客户端连接 SSE 的地址
MYSQL_MCP_URL=http://127.0.0.1:8000/sse
