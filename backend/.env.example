# LLM 模型配置
LLM_PROVIDER=openai
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_API_KEY=xxx
LLM_MODEL=glm-5.2

# 采样参数（留空则使用模型默认值）
LLM_TEMPERATURE=
LLM_MAX_TOKENS=
LLM_TOP_P=

# 连接参数
LLM_TIMEOUT=300
LLM_MAX_RETRIES=2

# Neo4j 知识图谱
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=xxx

# MySQLMCP
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=xxx
MYSQL_DATABASE=
MCP_TRANSPORT=sse
MCP_SSE_HOST=127.0.0.1
PORT=8001
MYSQL_MCP_URL=http://127.0.0.1:8001/sse

# MCP-Pandas
PANDAS_MCP_URL=http://127.0.0.1:8080/mcp





# ================ 多模态知识库 MRAG（配置项沿用 joyagent-jdgenie）================
# 文本 LLM：LLM_API_KEY 与系统大模型同名共用，地址和模型也直接复用系统配置
LLM_MODEL_BASE_URL=${LLM_BASE_URL}
LLM_MODEL_NAME=${LLM_MODEL}

# 阿里云 DashScope Key：VLM、文本向量、多模态向量、重排共用这一个
DASHSCOPE_API_KEY=

VLM_TYPE=openai
VLM_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_API_KEY=${DASHSCOPE_API_KEY}
VLM_MODEL_NAME=qwen3-vl-plus

TEXT_EMBEDDING_TYPE=openai
TEXT_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TEXT_EMBEDDING_API_KEY=${DASHSCOPE_API_KEY}
TEXT_EMBEDDING_MODEL_NAME=text-embedding-v4
TEXT_EMBEDDING_MAX_TEXT_LENGTH=8000
TEXT_EMBEDDING_DIMENSION=1024

IMAGE_EMBEDDING_TYPE=dashscope
DASHSCOPE_MULTIMODAL_EMBEDDING_BASE_URL=
DASHSCOPE_MULTIMODAL_EMBEDDING_MODEL_NAME=
IMAGE_EMBEDDING_DIMENSION=1024

# OCR：deepseek-ocr 或 vlm-ocr
OCR_TYPE=vlm-ocr
DEEPSEEK_OCR_BASE_URL=
DEEPSEEK_OCR_API_KEY=
DEEPSEEK_OCR_MODEL_NAME=

ENABLE_RERANKER=true
TEXT_RERANKER_TYPE=api
TEXT_RERANKER_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
TEXT_RERANKER_API_KEY=${DASHSCOPE_API_KEY}
TEXT_RERANKER_MODEL_NAME=qwen3-rerank

# MinerU 文档解析，Token 获取：https://mineru.net/apiManage/token（未配置时 PDF 退化为直接抽取文本）
MINERU_BASE_URL=https://mineru.net/api/v4/extract/task
MINERU_API_KEY=

CHUNK_TYPE=markdown
CHUNK_SIZE=500
CHUNK_OVERLAP=100
ENABLE_SUB_CHUNK_ENHANCE=true
SUB_CHUNK_SIZE=100

RETRIEVAL_TEXT_THRESHOLD=0.7
RETRIEVAL_IMAGE_THRESHOLD=0.6
RETRIEVAL_PAGE_THRESHOLD=0.35

# 存储（路径相对 backend 目录）。QDRANT_URL 留空 = 嵌入式本地模式，数据在 QDRANT_PATH
VECTOR_STORE_TYPE=qdrant
STORE_TYPE=sqlite
SQLITE_PATH=data/mrag/mrag_sqlite.db
QDRANT_URL=
QDRANT_PORT=6334
QDRANT_API_KEY=
QDRANT_PATH=data/mrag/qdrant
DEFAULT_KB_ID=1
TEXT_COLLECTION=t_joyagent_mrag_text_vectors
IMAGE_COLLECTION=t_joyagent_mrag_image_vectors
PAGE_COLLECTION=t_joyagent_mrag_page_vectors

# 文件存储：local 存本地磁盘并由 RAG 服务提供下载；改为 s3 时需配置下方 S3_*
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=data/mrag/storage
OSS_SERVER_BASE_URL=http://127.0.0.1:8000/storage
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_DIR=mrag

API_TIMEOUT=300
ENABLE_LIGHT_RAG=
LIGHTRAG_SERVER_BASE_URL=
